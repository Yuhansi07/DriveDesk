PORT=3000
HOST=127.0.0.1
# sqlite is zero-install local demo; postgres uses PostgreSQL and 'pg' npm dependency.
DB_DRIVER=sqlite
DB_PATH=./data/drivedesk-pro.db
# DB_DRIVER=postgres
# DATABASE_URL=postgres://postgres:your_password@127.0.0.1:5432/drivedesk
# DATABASE_SSL=false
# Allowed Flutter origins (use exact comma-separated origins in production)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
# Demo users seeded ONLY on an empty database in non-production environments
SEED_DEMO=1
# Set a long secret in production, plus HTTPS, rotate demo credentials.
SESSION_TTL_HOURS=12
# Optional: local OCR requires Tesseract installed; disabled by default
ENABLE_TESSERACT=0
# Optional: Python trained vehicle damage model service URL
AI_DAMAGE_URL=http://127.0.0.1:8001
